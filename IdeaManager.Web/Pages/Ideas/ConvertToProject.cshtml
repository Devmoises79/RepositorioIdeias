@page
@model IdeaManager.Web.Pages.Ideas.ConvertToProjectModel
@{
    ViewData["Title"] = "Converter Ideia em Projeto";
}
@using IdeaManager.Core.Enums

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="fade-in">
                <!-- Cabeçalho -->
                <div class="text-center mb-4">
                    <i class="bi bi-rocket-takeoff-fill display-1 text-warning mb-3"></i>
                    <h1 class="display-5 fw-bold text-white mb-2">🚀 Converter Ideia em Projeto</h1>
                    <p class="text-white-50">Transforme sua ideia em um projeto executável</p>
                </div>

                <!-- Card da Ideia Original - Versão Organizada -->
                <div class="card border-0 shadow-lg rounded-4 mb-4">
                    <div class="card-header bg-info text-white rounded-top-4 border-0 p-3">
                        <h5 class="mb-0">
                            <i class="bi bi-lightbulb me-2"></i>Ideia Original
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-3 text-primary">@Model.Idea.Title</h4>
                        
                        <div class="mb-3">
                            <div class="bg-light rounded-3 p-3">
                                <strong class="text-info">📝 Descrição:</strong>
                                <p class="mb-0 mt-1">@Model.Idea.Description</p>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="badge bg-secondary rounded-pill px-3 py-2">
                                <i class="bi bi-tag me-1"></i> @Model.Idea.Category
                            </span>
                            <small class="text-muted">
                                <i class="bi bi-calendar3 me-1"></i> @Model.Idea.CreatedAt.ToString("dd/MM/yyyy")
                            </small>
                        </div>
                    </div>
                </div>

                <!-- Formulário do Projeto -->
                <div class="card border-0 shadow-lg rounded-4">
                    <div class="card-header bg-gradient-primary text-white rounded-top-4 border-0 p-4">
                        <h3 class="mb-0">
                            <i class="bi bi-kanban me-2"></i>Detalhes do Projeto
                        </h3>
                    </div>
                    <div class="card-body p-4">
                        <form method="post" id="projectForm">
                            <input type="hidden" asp-for="Project.IdeaId" value="@Model.Idea.Id" />

                            <div class="mb-3">
                                <label asp-for="Project.Name" class="form-label fw-semibold">
                                    <i class="bi bi-type-bold me-1"></i>Nome do Projeto *
                                </label>
                                <input asp-for="Project.Name" class="form-control form-control-lg rounded-3" 
                                       placeholder="Digite o nome do projeto" />
                                <span asp-validation-for="Project.Name" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Project.Description" class="form-label fw-semibold">
                                    <i class="bi bi-textarea me-1"></i>Descrição do Projeto *
                                </label>
                                <textarea asp-for="Project.Description" class="form-control" rows="4" 
                                          placeholder="Descreva os objetivos e escopo do projeto"></textarea>
                                <span asp-validation-for="Project.Description" class="text-danger"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Project.StartDate" class="form-label fw-semibold">
                                        <i class="bi bi-calendar-check me-1"></i>Data de Início
                                    </label>
                                    <input asp-for="Project.StartDate" type="date" class="form-control rounded-3" />
                                    <span asp-validation-for="Project.StartDate" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Project.EndDate" class="form-label fw-semibold">
                                        <i class="bi bi-calendar-x me-1"></i>Data de Término (opcional)
                                    </label>
                                    <input asp-for="Project.EndDate" type="date" class="form-control rounded-3" />
                                    <span asp-validation-for="Project.EndDate" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Project.Status" class="form-label fw-semibold">
                                        <i class="bi bi-flag me-1"></i>Status Inicial
                                    </label>
                                    <select asp-for="Project.Status" class="form-select rounded-3">
                                        <option value="@ProjectStatus.Planning">📋 Planejamento</option>
                                        <option value="@ProjectStatus.InProgress">⚙️ Em andamento</option>
                                        <option value="@ProjectStatus.Paused">⏸️ Pausado</option>
                                    </select>
                                    <span asp-validation-for="Project.Status" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">
                                        <i class="bi bi-graph-up me-1"></i>Progresso Inicial (%)
                                    </label>
                                    <div class="d-flex align-items-center gap-3">
                                        <input asp-for="Project.ProgressPercentage" type="range" class="form-range" 
                                               min="0" max="100" step="5" oninput="updateProgressValue(this.value)" />
                                        <span class="badge bg-primary rounded-pill fs-6 px-3 py-2" style="min-width: 60px;">
                                            <span id="progressValue">0</span>%
                                        </span>
                                    </div>
                                    <span asp-validation-for="Project.ProgressPercentage" class="text-danger"></span>
                                </div>
                            </div>

                            <hr class="my-4" />

                            <!-- Aviso de conversão -->
                            <div class="alert alert-warning rounded-4">
                                <div class="d-flex align-items-start">
                                    <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                                    <div>
                                        <strong>Atenção!</strong><br />
                                        <small>Após converter esta ideia em projeto, ela não poderá ser convertida novamente. O status da ideia será alterado para "Convertida".</small>
                                    </div>
                                </div>
                            </div>

                            <!-- Botões -->
                            <div class="d-flex justify-content-between gap-3 mt-4">
                                <a asp-page="Details" asp-route-id="@Model.Idea.Id" class="btn btn-secondary btn-lg px-4 rounded-pill">
                                    <i class="bi bi-arrow-left me-2"></i>Cancelar
                                </a>
                                <button type="submit" class="btn btn-success btn-lg px-5 rounded-pill">
                                    <i class="bi bi-rocket-takeoff me-2"></i>Converter em Projeto
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateProgressValue(value) {
            document.getElementById('progressValue').innerText = value;
        }
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}