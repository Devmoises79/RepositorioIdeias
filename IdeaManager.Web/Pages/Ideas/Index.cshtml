@page
@model IdeaManager.Web.Pages.Ideas.IndexModel
@{
    ViewData["Title"] = "Minhas Ideias";
}
@using IdeaManager.Core.Enums

<div class="container">
    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="display-5 fw-bold text-white mb-2">
                <i class="bi bi-lightbulb-fill text-warning"></i> Minhas Ideias
            </h1>
            <p class="text-white-50">Gerencie e acompanhe suas ideias do rascunho à execução</p>
        </div>
        <a asp-page="Create" class="btn btn-light btn-lg rounded-pill shadow">
            <i class="bi bi-plus-circle-fill me-2"></i>Nova Ideia
        </a>
    </div>

    @if (!Model.Ideas.Any())
    {
        <!-- Card de Boas-Vindas -->
        <div class="card border-0 shadow-lg rounded-4 bg-white text-center">
            <div class="card-body py-5 px-4">
                <div class="mb-4">
                    <i class="bi bi-emoji-smile-fill display-1 text-warning"></i>
                </div>
                <h3 class="fw-bold mb-3">Bem-vindo ao Idea Manager!</h3>
                <p class="text-muted mb-4">
                    Você ainda não tem nenhuma ideia registrada.<br>
                    Comece agora mesmo registrando sua primeira ideia!
                </p>
                <a asp-page="Create" class="btn btn-primary btn-lg rounded-pill px-5">
                    <i class="bi bi-plus-circle me-2"></i>Criar Primeira Ideia
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var idea in Model.Ideas)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-lg rounded-4 hover-lift">
                        <div class="card-body p-4">
                            <!-- Badge de Status -->
                            <div class="mb-3">
                                @if (idea.Status == IdeaStatus.Converted && idea.Project != null)
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-2">
                                        <i class="bi bi-rocket-takeoff me-1"></i> Convertida em Projeto
                                    </span>
                                }
                                else
                                {
                                    switch (idea.Status)
                                    {
                                        case IdeaStatus.Draft:
                                            <span class="badge bg-secondary rounded-pill px-3 py-2">
                                                <i class="bi bi-pencil me-1"></i> Rascunho
                                            </span>
                                            break;
                                        case IdeaStatus.Active:
                                            <span class="badge bg-info rounded-pill px-3 py-2">
                                                <i class="bi bi-stars me-1"></i> Em avaliação
                                            </span>
                                            break;
                                        case IdeaStatus.Discarded:
                                            <span class="badge bg-danger rounded-pill px-3 py-2">
                                                <i class="bi bi-trash me-1"></i> Descartada
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary rounded-pill px-3 py-2">
                                                <i class="bi bi-pencil me-1"></i> Rascunho
                                            </span>
                                            break;
                                    }
                                }
                            </div>

                            <!-- Título -->
                            <h5 class="card-title fw-bold mb-2">@idea.Title</h5>
                            
                            <!-- Descrição -->
                            <p class="card-text text-muted">
                                @(idea.Description.Length > 100 ? idea.Description.Substring(0, 100) + "..." : idea.Description)
                            </p>
                            
                            <!-- Categoria -->
                            <div class="mb-3">
                                <span class="badge bg-light text-dark rounded-pill">
                                    <i class="bi bi-tag me-1"></i> @idea.Category
                                </span>
                            </div>

                            <!-- SE FOR CONVERTIDA, MOSTRA INFORMAÇÕES DO PROJETO -->
                            @if (idea.Status == IdeaStatus.Converted && idea.Project != null)
                            {
                                <div class="mt-3 pt-3 border-top">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bi bi-kanban text-success"></i>
                                        <strong class="small">Projeto:</strong>
                                        <span class="small">@idea.Project.Name</span>
                                    </div>
                                    
                                    <!-- Barra de Progresso do Projeto -->
                                    <div class="mt-2">
                                        <div class="d-flex justify-content-between mb-1">
                                            <small class="text-muted">Progresso do Projeto</small>
                                            <small class="fw-bold text-success">@idea.Project.ProgressPercentage%</small>
                                        </div>
                                        <div class="progress rounded-pill" style="height: 6px;">
                                            <div class="progress-bar bg-success rounded-pill" 
                                                 style="width: @idea.Project.ProgressPercentage%"></div>
                                        </div>
                                    </div>

                                    <!-- Status do Projeto -->
                                    <div class="mt-2">
                                        <small class="text-muted">
                                            Status do Projeto:
                                            @switch (idea.Project.Status)
                                            {
                                                case ProjectStatus.Planning:
                                                    <span class="text-secondary">📋 Planejamento</span>
                                                    break;
                                                case ProjectStatus.InProgress:
                                                    <span class="text-primary">⚙️ Em andamento</span>
                                                    break;
                                                case ProjectStatus.Paused:
                                                    <span class="text-warning">⏸️ Pausado</span>
                                                    break;
                                                case ProjectStatus.Completed:
                                                    <span class="text-success">✅ Concluído</span>
                                                    break;
                                                default:
                                                    <span class="text-danger">❌ Cancelado</span>
                                                    break;
                                            }
                                        </small>
                                    </div>
                                </div>
                            }

                            <!-- Data -->
                            <small class="text-muted d-block mt-2">
                                <i class="bi bi-calendar3 me-1"></i> Criada em @idea.CreatedAt.ToString("dd/MM/yyyy")
                            </small>
                        </div>

                        <!-- Botões de Ação -->
                        <div class="card-footer bg-transparent border-0 p-4 pt-0">
                            <div class="d-flex gap-2 flex-wrap">
                                <a asp-page="Details" asp-route-id="@idea.Id" class="btn btn-outline-primary rounded-pill flex-grow-1">
                                    <i class="bi bi-eye"></i> Ver
                                </a>
                                
                                @if (idea.Status != IdeaStatus.Converted)
                                {
                                    <a asp-page="Edit" asp-route-id="@idea.Id" class="btn btn-outline-warning rounded-pill">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-page="ConvertToProject" asp-route-id="@idea.Id" class="btn btn-outline-success rounded-pill">
                                        <i class="bi bi-rocket-takeoff"></i>
                                    </a>
                                }
                                else
                                {
                                    <!-- Se convertida, botão para ver o projeto -->
                                    <a asp-page="/Projects/Details" asp-route-id="@idea.Project.Id" class="btn btn-outline-success rounded-pill flex-grow-1">
                                        <i class="bi bi-kanban"></i> Ver Projeto
                                    </a>
                                }
                                
                                @if (idea.Status != IdeaStatus.Converted)
                                {
                                    <a asp-page="Delete" asp-route-id="@idea.Id" class="btn btn-outline-danger rounded-pill">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .hover-lift {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .hover-lift:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.15) !important;
    }
</style>