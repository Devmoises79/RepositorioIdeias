@page
@model IndexModel
@{
    ViewData["Title"] = "Home - Idea Manager";
}

<div class="container">
    <!-- Hero Section -->
    <div class="row justify-content-center text-center mb-5">
        <div class="col-lg-8">
            <div class="fade-in">
                <i class="bi bi-lightbulb-fill display-1 text-warning mb-3"></i>
                <h1 class="display-3 fw-bold text-white mb-3">
                    Transforme suas Ideias em Realidade
                </h1>
                <p class="lead text-white-50 mb-4">
                    Gerencie, organize e acompanhe suas ideias desde o rascunho até a execução completa dos seus projetos.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-page="/Ideas/Index" class="btn btn-light btn-lg rounded-pill px-5 shadow">
                        <i class="bi bi-lightbulb me-2"></i>Minhas Ideias
                    </a>
                    <a asp-page="/Ideas/Create" class="btn btn-outline-light btn-lg rounded-pill px-5">
                        <i class="bi bi-plus-circle me-2"></i>Nova Ideia
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Section -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-lg rounded-4 text-center h-100 hover-lift">
                <div class="card-body p-4">
                    <i class="bi bi-pencil-square display-3 text-primary mb-3"></i>
                    <h3 class="fw-bold mb-2">Rascunhe</h3>
                    <p class="text-muted">Registre suas ideias rapidamente antes que se percam</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-lg rounded-4 text-center h-100 hover-lift">
                <div class="card-body p-4">
                    <i class="bi bi-graph-up display-3 text-success mb-3"></i>
                    <h3 class="fw-bold mb-2">Organize</h3>
                    <p class="text-muted">Categorize e priorize suas ideias por importância</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-lg rounded-4 text-center h-100 hover-lift">
                <div class="card-body p-4">
                    <i class="bi bi-rocket-takeoff display-3 text-warning mb-3"></i>
                    <h3 class="fw-bold mb-2">Execute</h3>
                    <p class="text-muted">Converta ideias em projetos e acompanhe o progresso</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Features Section -->
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-lg rounded-4 bg-white">
                <div class="card-body p-5">
                    <h2 class="text-center fw-bold mb-4">
                        <i class="bi bi-star-fill text-warning me-2"></i>
                        Por que usar o Idea Manager?
                    </h2>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="d-flex align-items-start gap-3">
                                <i class="bi bi-check-circle-fill text-success fs-3 mt-1"></i>
                                <div>
                                    <h5 class="fw-bold">Gestão Completa</h5>
                                    <p class="text-muted">Acompanhe todas suas ideias em um só lugar</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start gap-3">
                                <i class="bi bi-bar-chart-steps text-info fs-3 mt-1"></i>
                                <div>
                                    <h5 class="fw-bold">Acompanhamento Visual</h5>
                                    <p class="text-muted">Veja o progresso das suas ideias em tempo real</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start gap-3">
                                <i class="bi bi-tags text-primary fs-3 mt-1"></i>
                                <div>
                                    <h5 class="fw-bold">Organização por Categorias</h5>
                                    <p class="text-muted">Classifique suas ideias para fácil localização</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start gap-3">
                                <i class="bi bi-arrow-repeat text-warning fs-3 mt-1"></i>
                                <div>
                                    <h5 class="fw-bold">Conversão em Projetos</h5>
                                    <p class="text-muted">Transforme ideias promissoras em projetos executáveis</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CTA Section -->
    <div class="row justify-content-center mt-5">
        <div class="col-lg-8 text-center">
            <div class="card bg-gradient-primary border-0 shadow-lg rounded-4 text-white">
                <div class="card-body p-5">
                    <i class="bi bi-emoji-smile display-1 mb-3"></i>
                    <h2 class="fw-bold mb-3">Pronto para começar?</h2>
                    <p class="mb-4 opacity-90">Registre sua primeira ideia agora e dê o primeiro passo!</p>
                    <a asp-page="/Ideas/Create" class="btn btn-light btn-lg rounded-pill px-5 shadow">
                        <i class="bi bi-plus-circle me-2"></i>Criar Nova Ideia
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>